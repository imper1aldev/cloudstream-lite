<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="132dp" android:layout_height="wrap_content" android:layout_marginEnd="12dp"
    android:orientation="vertical" android:gravity="center_horizontal" android:padding="4dp">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/nexo_tv_actor_image"
        android:layout_width="88dp" android:layout_height="88dp" android:scaleType="centerCrop"
        android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/NexoTvDetailsPortrait" />
    <TextView android:id="@+id/nexo_tv_actor_name"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:textSize="14sp" android:textStyle="bold" android:textColor="#F1F2F6" android:gravity="center"
        android:minLines="2" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/nexo_tv_actor_role"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
        android:textSize="12sp" android:textColor="#AAB5C8" android:gravity="center"
        android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
