<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="184dp" android:layout_height="wrap_content" android:minHeight="64dp" android:layout_marginEnd="10dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp"
    android:background="@drawable/nexo_tv_card_background">
    <com.google.android.material.imageview.ShapeableImageView android:id="@+id/nexo_tv_actor_image"
        android:layout_width="40dp" android:layout_height="40dp" android:scaleType="centerCrop"
        android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/NexoTvDetailsPortrait" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="10dp">
        <TextView android:id="@+id/nexo_tv_actor_name"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="12sp" android:textStyle="bold" android:textColor="#F1F2F6"
            android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/nexo_tv_actor_role"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp"
            android:textSize="11sp" android:textColor="#AAB5C8"
            android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
