<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nexo_tv_result_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0E1014">

    <com.lagradost.cloudstream3.ui.tv.NexoTvDetailsScrollView
        android:id="@+id/nexo_tv_result_scroll"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="36dp">

            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="410dp">
                <ImageView android:id="@+id/nexo_tv_result_backdrop"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="centerCrop" android:importantForAccessibility="no" />
                <View android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@drawable/nexo_tv_details_shade" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:paddingStart="40dp" android:paddingEnd="32dp"
                    android:paddingTop="40dp" android:paddingBottom="32dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.66">
                        <TextView android:id="@+id/nexo_tv_result_title"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textSize="34sp" android:textStyle="bold"
                            android:fontFamily="sans-serif-black" android:textColor="#FFFFFF" />
                        <TextView android:id="@+id/nexo_tv_result_meta"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" android:textSize="14sp"
                            android:textColor="#C4CBD8" android:lineSpacingExtra="2dp" />
                        <com.google.android.material.chip.ChipGroup android:id="@+id/nexo_tv_result_genres"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="6dp"
                            android:visibility="gone" />
                        <TextView android:id="@+id/nexo_tv_result_plot"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="16dp" android:textSize="16sp" android:lineSpacingExtra="2dp"
                            android:textColor="#D5DCE8" android:maxLines="3" android:ellipsize="end" />
                        <TextView android:id="@+id/nexo_tv_result_more"
                            style="@style/NexoTvDetailsAction" android:layout_height="44dp"
                            android:layout_marginTop="8dp" android:minHeight="44dp"
                            android:background="@drawable/nexo_tv_text_focus"
                            android:paddingStart="8dp" android:paddingEnd="8dp" android:textColor="#D5DCE8"
                            android:text="@string/lite_more" android:textSize="13sp" android:visibility="gone" />
                        <LinearLayout android:id="@+id/nexo_tv_result_resume"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical" android:layout_marginTop="16dp" android:padding="12dp"
                            android:background="@drawable/nexo_tv_resume_background" android:visibility="gone">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:text="@string/resume" android:textSize="12sp" android:textColor="#AFBFE3" />
                            <TextView android:id="@+id/nexo_tv_result_resume_title"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:textSize="16sp" android:textStyle="bold"
                                android:textColor="#FFFFFF" android:maxLines="2" android:ellipsize="end" />
                            <LinearLayout android:id="@+id/nexo_tv_result_resume_progress_row"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="8dp" android:orientation="horizontal" android:gravity="center_vertical">
                                <ProgressBar android:id="@+id/nexo_tv_result_resume_progress"
                                    style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp"
                                    android:layout_weight="1" android:layout_height="3dp" android:max="100"
                                    android:progressTint="@color/colorAccent" android:progressBackgroundTint="#3C4964" />
                                <TextView android:id="@+id/nexo_tv_result_resume_percent"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp" android:textSize="12sp" android:textColor="#D5DCE8" />
                            </LinearLayout>
                            <TextView android:id="@+id/nexo_tv_result_resume_remaining"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#AFBFE3" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="horizontal" android:gravity="center_vertical"
                            android:layout_marginTop="20dp" android:clipChildren="false">
                            <TextView android:id="@+id/nexo_tv_result_play" style="@style/NexoTvDetailsAction"
                                android:minWidth="160dp" android:drawableStart="@drawable/ic_baseline_play_arrow_24"
                                android:drawableTint="@color/nexo_tv_details_action_tint" android:drawablePadding="10dp"
                                android:text="@string/play_episode" />
                            <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/nexo_tv_result_favorite"
                                android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="12dp"
                                android:padding="14dp" android:scaleType="fitCenter"
                                android:background="@drawable/nexo_tv_details_secondary"
                                android:focusable="true" android:clickable="true"
                                android:contentDescription="@string/favorite"
                                app:srcCompat="@drawable/ic_baseline_favorite_border_24"
                                app:tint="@color/nexo_tv_details_action_tint" />
                            <!-- Secondary actions remain hidden until their phase connects real callbacks. -->
                            <TextView android:id="@+id/nexo_tv_result_cast" style="@style/NexoTvAction"
                                android:text="@string/lite_cast_action" android:visibility="gone" />
                            <TextView android:id="@+id/nexo_tv_result_download" style="@style/NexoTvAction"
                                android:text="@string/download" android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingStart="40dp" android:paddingEnd="32dp">
                <LinearLayout android:id="@+id/nexo_tv_result_episode_controls"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="16dp" android:visibility="gone">
                    <TextView android:id="@+id/nexo_tv_result_season" style="@style/NexoTvDetailsSelector" android:visibility="gone" />
                    <TextView android:id="@+id/nexo_tv_result_dub" style="@style/NexoTvDetailsSelector" android:visibility="gone" />
                    <TextView android:id="@+id/nexo_tv_result_range" style="@style/NexoTvDetailsSelector" android:visibility="gone" />
                </LinearLayout>
                <TextView android:id="@+id/nexo_tv_result_episode_status"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="22sp" android:textStyle="bold" android:textColor="#FFFFFF" android:layout_marginTop="12dp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/nexo_tv_result_episodes"
                    android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="12dp"
                    android:clipChildren="false" android:clipToPadding="false" android:padding="8dp" android:nestedScrollingEnabled="false" />
                <TextView android:id="@+id/nexo_tv_result_actor_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/nexo_tv_details_cast" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="#FFFFFF" android:layout_marginTop="28dp" android:visibility="gone" />
                <TextView android:id="@+id/nexo_tv_result_actor_text"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textSize="14sp" android:textColor="#C4CBD8"
                    android:lineSpacingExtra="3dp" android:visibility="gone" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/nexo_tv_result_actors"
                    android:layout_width="match_parent" android:layout_height="196dp" android:layout_marginTop="12dp"
                    android:padding="8dp" android:clipToPadding="false" android:nestedScrollingEnabled="false"
                    android:focusable="true" android:focusableInTouchMode="true" android:descendantFocusability="blocksDescendants"
                    android:background="@drawable/nexo_tv_text_focus" android:contentDescription="@string/nexo_tv_details_cast_scroll"
                    android:visibility="gone" />
                <TextView android:id="@+id/nexo_tv_result_recommendation_title"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="@string/lite_recommendations" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="#FFFFFF" android:layout_marginTop="28dp" />
                <androidx.recyclerview.widget.RecyclerView android:id="@+id/nexo_tv_result_recommendations"
                    android:layout_width="match_parent" android:layout_height="252dp" android:layout_marginTop="12dp"
                    android:clipChildren="false" android:clipToPadding="false" android:padding="8dp" android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </LinearLayout>
    </com.lagradost.cloudstream3.ui.tv.NexoTvDetailsScrollView>

    <LinearLayout android:id="@+id/nexo_tv_result_status"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:gravity="center" android:background="#0E1014">
        <TextView android:id="@+id/nexo_tv_result_message"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/loading" android:textSize="20sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/nexo_tv_result_retry" style="@style/NexoTvAction"
            android:text="@string/retry" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
