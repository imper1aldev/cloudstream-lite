<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="224dp" android:layout_height="match_parent" android:layout_marginEnd="12dp" android:orientation="vertical" android:background="@drawable/nexo_tv_card_background" android:padding="6dp" android:focusable="true" android:clickable="true">
 <ImageView android:id="@+id/nexo_tv_episode_image" android:layout_width="match_parent" android:layout_height="116dp" android:scaleType="centerCrop" android:importantForAccessibility="no" />
 <ProgressBar android:id="@+id/nexo_tv_episode_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:max="100" />
 <TextView android:id="@+id/nexo_tv_episode_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFFFFF" android:textSize="17sp" android:maxLines="2" android:ellipsize="end" />
 <TextView android:id="@+id/nexo_tv_episode_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#BDC2CF" android:textSize="14sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
