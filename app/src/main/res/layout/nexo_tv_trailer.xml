<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#000000">
    <androidx.media3.ui.PlayerView android:id="@+id/nexo_tv_trailer_player"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:focusable="true" app:use_controller="true" app:show_buffering="always" />
    <TextView android:id="@+id/nexo_tv_trailer_error"
        android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
        android:padding="48dp" android:text="@string/nexo_tv_trailer_failed"
        android:textSize="20sp" android:textColor="#FFFFFF" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="48dp"
        android:paddingEnd="48dp" android:paddingTop="27dp" android:paddingBottom="16dp" android:background="#B3000000">
        <androidx.appcompat.widget.AppCompatImageButton android:id="@+id/nexo_tv_trailer_close"
            android:layout_width="52dp" android:layout_height="52dp" android:padding="14dp"
            android:background="@drawable/nexo_tv_details_secondary" android:focusable="true"
            android:contentDescription="@string/go_back" android:nextFocusDown="@id/nexo_tv_trailer_player"
            app:srcCompat="@drawable/ic_baseline_arrow_back_24" app:tint="@color/nexo_tv_details_action_tint" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="16dp" android:text="@string/trailer" android:textSize="22sp" android:textColor="#FFFFFF" />
    </LinearLayout>
</FrameLayout>
