<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:background="#0E1014">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/favorites_list_name" android:textColor="#FFFFFF" android:textSize="28sp" android:textStyle="bold" />
 <EditText android:id="@+id/nexo_tv_favorites_query" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:hint="@string/title_search" android:textColor="#FFFFFF" android:textColorHint="#BDC2CF" android:textSize="18sp" android:singleLine="true" android:inputType="text" android:imeOptions="actionDone" />
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
  <TextView android:id="@+id/nexo_tv_favorites_downloaded" style="@style/NexoTvAction" android:text="@string/lite_downloaded_filter" />
  <TextView android:id="@+id/nexo_tv_favorites_sort" style="@style/NexoTvAction" android:text="@string/lite_sort" />
  <TextView android:id="@+id/nexo_tv_favorites_options" style="@style/NexoTvAction" android:text="@string/lite_options" />
 </LinearLayout>
 <TextView android:id="@+id/nexo_tv_favorites_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="#D5D8E0" android:textSize="18sp" />
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/nexo_tv_favorites_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="8dp" android:clipChildren="false" android:clipToPadding="false" />
</LinearLayout>
