<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:paddingTop="12dp" android:paddingBottom="8dp" android:clipChildren="false">
    <TextView android:id="@+id/nexo_tv_row_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="16dp" android:paddingHorizontal="8dp" android:layout_marginBottom="4dp"
        android:background="@drawable/nexo_tv_text_focus" android:textColor="#F5F7FA" android:textSize="24sp" android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/nexo_tv_row_list"
        android:layout_width="match_parent" android:layout_height="@dimen/nexo_tv_home_row_height" android:paddingHorizontal="16dp"
        android:paddingVertical="4dp" android:clipToPadding="false" android:clipChildren="false" />
    <Button android:id="@+id/nexo_tv_row_retry" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="24dp" android:text="@string/retry" android:visibility="gone" />
</LinearLayout>
