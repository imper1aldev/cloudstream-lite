<resources>
    <style name="NexoTvDetailsAction">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nexo_tv_details_action_tint</item>
        <item name="android:background">@drawable/nexo_tv_details_primary</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="NexoTvDetailsGenre" parent="ChipFilled">
        <item name="chipBackgroundColor">#6618202D</item>
        <item name="chipStrokeColor">#506C7A92</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">24dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="android:textAppearance">@style/NexoTvDetailsGenreText</item>
    </style>
    <style name="NexoTvDetailsGenreText" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="NexoTvDetailsSelector" parent="NexoTvDetailsAction">
        <item name="android:layout_height">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:background">@drawable/nexo_tv_details_secondary</item>
        <item name="android:drawableEnd">@drawable/nexo_tv_details_expand</item>
        <item name="android:drawableTint">@color/nexo_tv_details_action_tint</item>
        <item name="android:drawablePadding">8dp</item>
    </style>
    <style name="NexoTvDetailsPortrait">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="NexoTvTrailerDialogTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
