<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="20dp" android:background="#101114">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="NexoStream TV · prueba aislada" android:textSize="26sp"
        android:textColor="#ffffff" android:paddingBottom="16dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/nexo_tv_probe_first"
        android:layout_width="match_parent" android:layout_height="150dp"
        android:clipToPadding="false" android:paddingHorizontal="8dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/nexo_tv_probe_second"
        android:layout_width="match_parent" android:layout_height="150dp"
        android:clipToPadding="false" android:paddingHorizontal="8dp" />
</LinearLayout>
